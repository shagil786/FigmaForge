{
  "name": "figmaforge-runtime",
  "version": "0.0.1-dev",
  "description": "TypeScript orchestration runtime for the FigmaForge visual repair pipeline",
  "type": "module",
  "bin": {
    "figmaforge": "./dist/src/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "cd .. && node --experimental-vm-modules runtime/dist/tests/run_all.js",
    "test:integration": "cd .. && node --experimental-vm-modules runtime/dist/tests/run_all.js --integration",
    "figmaforge": "node dist/src/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
