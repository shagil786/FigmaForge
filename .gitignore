# ---------------------------------------------------------------------------
# FigmaForge .gitignore
# Items here must NOT be committed or pushed. Add/remove as the project evolves.
# ---------------------------------------------------------------------------

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
*.log

# Claude Code local state (never share personal session/config data)
.claude/settings.local.json
.claude/worktrees/
.claude/projects/
.claude.json

# Former Qoder auto-generated knowledge base tooling (now removed)

# Freebuff desktop local state (app database — never share)
.freebuff/

# FigmaForge runtime state (state machine writes .figmaforge/runs/...)
.figmaforge/

# Backup artifacts (created by the documented backup/rollback workflow)
repository.bundle
worktree.tar.gz
FigmaForge.backups/
*.backups/

# Stale local-dev marketplace reference (real plugin lives under plugin/figmaforge/)
/figmaforge/

# macOS
.DS_Store

# Editors / IDEs
.idea/
*.iml
